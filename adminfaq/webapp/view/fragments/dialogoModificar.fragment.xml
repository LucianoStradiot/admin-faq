<core:FragmentDefinition xmlns:core="sap.ui.core"
	xmlns="sap.m"
	xmlns:u="sap.ui.unified"
	xmlns:f="sap.ui.layout.form"
	xmlns:l="sap.ui.layout">
	<Dialog title="{i18n>editar}" contentWidth="400px">
		<content>
			<f:SimpleForm id="oSimpleFormEditId" editable="false" layout="ResponsiveGridLayout"
				labelSpanXL="2" labelSpanL="2" labelSpanM="2" labelSpanS="2" adjustLabelSpan="false"
				emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2"
				columnsL="2" columnsM="2" singleContainerFullSize="false">
				<f:content>
					<VBox>
						<Label text="{i18n>type}" required="true"/>
						<Input id="inputTYPEEditar" maxLength="99" width="100%" value="{oModelEdit>/TYPE}" required="true" />
						<layoutData>
							<l:GridData span="XL12 L12 M12 S12" />
						</layoutData>
					</VBox>
					<VBox>
						<Label text="{i18n>QUESTION}" required="true"/>
						<TextArea id="inputQUESTIONEditar" value="{oModelEdit>/QUESTION}"
							editable="true"
							showExceededText="false" maxLength="999" width="100%"
							valueState="{= ${/value}.length > 999 ? 'Warning' : 'None' }"
							valueLiveUpdate="false" liveChange="handleLiveChange" />
						<layoutData>
							<l:GridData span="XL12 L12 M12 S12" />
						</layoutData>
					</VBox>
					<VBox>
						<Label text="{i18n>ANSWER}" required="true"/>
						<TextArea id="inputANSWEREditar" value="{oModelEdit>/ANSWER}"
							editable="true"
							showExceededText="false" maxLength="999" width="100%"
							valueState="{= ${/value}.length > 999 ? 'Warning' : 'None' }"
							valueLiveUpdate="false" liveChange="handleLiveChange" />
						<layoutData>
							<l:GridData span="XL12 L12 M12 S12" />
						</layoutData>
					</VBox>
					<VBox>
						<Label text="{i18n>estado}" />
						<RadioButtonGroup id="inputDeleteStatus" columns="2">
							<RadioButton text="{i18n>activo}"
								selected="{= ${oModelEdit>/DELETESTATUS} === '1' ? true : false }" />
							<RadioButton text="{i18n>inactivo}"
								selected="{= ${oModelEdit>/DELETESTATUS} === '0' ? true : false }" />
						</RadioButtonGroup>
						<layoutData>
							<l:GridData span="XL6 L6 M6 S6" />
						</layoutData>
					</VBox>
				</f:content>
			</f:SimpleForm>
		</content>
		<buttons>
			<Button text="{i18n>guardar}" type="Emphasized" press="onDialogOk2" />
			<Button text="{i18n>cancelar}" press="dialogModificarClose" />
		</buttons>
	</Dialog>
</core:FragmentDefinition>